<%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
<% hide_host_chrome = controller.class.name.start_with?(
     "RecordingStudioSupport::",
     "RecordingStudioAdmin::",
     "RecordingStudioMoveable::"
   ) %>
<% if user_signed_in? && !hide_host_chrome %>
  <% recording_studio_page_nav_right do %>
    <%= render FlatPack::Button::Component.new(
      text: "Sign out",
      style: :ghost,
      size: :md,
      href: main_app.destroy_user_session_path,
      data: { turbo_method: :delete }
    ) %>
    <%= recording_studio_root_switch_dropdown(style: :ghost, size: :md) %>
  <% end %>
<% end %>
