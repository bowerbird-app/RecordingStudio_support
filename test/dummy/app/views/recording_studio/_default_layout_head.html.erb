<%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
<% support_action_view = controller.class.name.start_with?("RecordingStudioSupport::") %>
<% if user_signed_in? && !support_action_view %>
  <% recording_studio_page_nav_right do %>
    <%= render FlatPack::Button::Component.new(
      text: "Sign out",
      style: :ghost,
      size: :md,
      href: main_app.destroy_user_session_path,
      data: { turbo_method: :delete }
    ) %>
    <%= recording_studio_root_switch_dropdown(style: :ghost, size: :md) %>
  <% end %>
<% end %>
