<% content_for :title, t("dummy.home.title") %>
<% content_for :subtitle, t("dummy.home.subtitle") %>
<% flat_pack_page_nav(round: true, style: :default) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::Card::Component.new(background: :default, border: :default) do |card| %>
    <% card.body do %>
      <p class="text-sm leading-6 text-(--surface-content-color)">
        <%= t("dummy.home.intro") %>
      </p>
    <% end %>
    <% card.footer do %>
      <%= render FlatPack::Button::Component.new(
        text: t("dummy.home.open_help"),
        style: :primary,
        size: :md,
        href: "/help"
      ) %>
    <% end %>
  <% end %>
</div>
