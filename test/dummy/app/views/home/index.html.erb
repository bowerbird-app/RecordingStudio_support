<% recording_studio_page_nav(title: t("dummy.home.title")) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: t("dummy.home.title"),
    subtitle: t("dummy.home.subtitle"),
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <p class="text-sm leading-6 text-(--surface-content-color)">
        <%= t("dummy.home.intro") %>
      </p>
    <% end %>
    <% card.footer do %>
      <%= render FlatPack::Button::Component.new(
        text: t("dummy.home.open_help"),
        style: :primary,
        size: :md,
        href: "/help"
      ) %>
    <% end %>
  <% end %>
</div>
