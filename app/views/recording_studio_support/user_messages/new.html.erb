<% recording_studio_page_nav(
     title: support_t("messages.new.title"),
     page_nav_back_url: help_messages_path_for_desk,
     page_nav_anchor_url: help_messages_path_for_desk,
     page_nav_anchor_label: support_t("messages.new.close")
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: support_t("messages.new.title"),
    subtitle: support_t("messages.new.subtitle"),
    variant: :h1
  ) %>

  <%= form_with url: help_messages_path_for_desk, method: :post, scope: :ticket do %>
    <div class="flex flex-col gap-4">
      <% if @ticket.errors.any? %>
        <%= render FlatPack::Alert::Component.new(
          style: :danger,
          title: @ticket.errors.full_messages.to_sentence
        ) %>
      <% end %>

      <%= render FlatPack::TextInput::Component.new(
        name: "ticket[subject]",
        label: support_t("messages.new.subject"),
        value: @ticket.subject,
        required: true,
        error: @ticket.errors[:subject].presence&.to_sentence
      ) %>

      <%= render FlatPack::Select::Component.new(
        name: "ticket[priority]",
        label: support_t("messages.new.priority"),
        options: support_ticket_priority_options,
        value: @ticket.priority
      ) %>

      <%= render FlatPack::TextArea::Component.new(
        name: "ticket[body]",
        label: support_t("messages.new.body"),
        value: @body,
        rows: 6,
        required: true
      ) %>

      <div class="flex gap-2">
        <%= render FlatPack::Button::Component.new(
          text: support_t("messages.new.send"),
          style: :primary,
          size: :md,
          type: "submit"
        ) %>
        <%= render FlatPack::Button::Component.new(
          text: support_t("messages.new.cancel"),
          style: :secondary,
          size: :md,
          href: help_messages_path_for_desk
        ) %>
      </div>
    </div>
  <% end %>
</div>
