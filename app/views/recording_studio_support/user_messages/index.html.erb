<% support_page_chrome(
     title: support_t("messages.title"),
     subtitle: support_t("messages.subtitle")
   ) %>
<% register_page_nav support_t("messages.new_ticket"), new_help_message_path_for_desk, role: :primary %>

<div class="flex w-full flex-col gap-6">
  <% if @tickets.any? %>
    <%= render "recording_studio_support/shared/link_list", items: @tickets.map { |ticket|
      {
        title: ticket.subject,
        href: help_message_path_for_desk(ticket),
        meta: support_ticket_status_badge(ticket)
      }
    } %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: support_t("messages.empty_title"),
      description: support_t("messages.empty_description")
    ) do |empty| %>
      <% empty.item do %>
        <%= render FlatPack::Button::Component.new(
          text: support_t("messages.new_ticket"),
          style: :primary,
          size: :md,
          href: new_help_message_path_for_desk
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
