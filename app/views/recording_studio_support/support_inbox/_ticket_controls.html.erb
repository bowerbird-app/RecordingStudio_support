<% mobile = local_assigns.fetch(:mobile, false) %>
<% html_id = support_ticket_controls_id(ticket, mobile: mobile) %>
<% field_prefix = mobile ? "support-ticket-mobile" : "support-ticket" %>
<% status_label = support_ticket_status_label_for(ticket.status) %>

<%= tag.div id: html_id do %>
  <%= render FlatPack::Button::Dropdown::Component.new(
    text: status_label,
    style: :default,
    size: :md,
    placement: :bottom_left,
    trigger_attributes: {
      id: "#{field_prefix}-status-#{ticket.id}",
      aria: { label: "Status" }
    }
  ) do |dropdown| %>
    <% dropdown.with_trigger_label { status_label } %>
    <% support_ticket_status_options.each do |label, status| %>
      <% dropdown.menu_html(support_ticket_status_action(ticket, label: label, status: status)) %>
    <% end %>
  <% end %>
<% end %>
