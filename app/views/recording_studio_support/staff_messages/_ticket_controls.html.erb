<% mobile = local_assigns.fetch(:mobile, false) %>
<% html_id = support_ticket_controls_id(ticket, mobile: mobile) %>
<% field_prefix = mobile ? "support-ticket-mobile" : "support-ticket" %>
<% status_width = mobile ? "w-24" : "w-56" %>

<%= tag.div id: html_id do %>
  <%= form_with url: staff_ticket_update_path_for(ticket),
                method: :patch,
                scope: :ticket,
                html: {
                  id: "#{html_id}-form",
                  data: { turbo: true, turbo_stream: true },
                  onchange: "this.requestSubmit()"
                } do %>
    <div class="flex items-center gap-1.5">
      <div class="<%= status_width %> shrink-0">
        <%= render FlatPack::Select::Component.new(
          name: "ticket[status]",
          id: "#{field_prefix}-status-#{ticket.id}",
          label: nil,
          options: support_ticket_status_options,
          value: ticket.status,
          placeholder: nil,
          chrome: :cell,
          aria: { label: "Status" }
        ) %>
      </div>
    </div>
  <% end %>
<% end %>
