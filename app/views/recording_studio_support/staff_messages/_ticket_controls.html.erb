<% html_id = support_ticket_controls_id(ticket) %>

<%= tag.div id: html_id,
            class: "flex-shrink-0 border-b border-[var(--chat-header-border-color)] bg-[var(--chat-header-background-color)] px-4 py-2" do %>
  <%= form_with url: staff_ticket_update_path_for(ticket),
                method: :patch,
                scope: :ticket,
                html: {
                  id: "#{html_id}-form",
                  data: { turbo: true, turbo_stream: true },
                  onchange: "this.requestSubmit()"
                } do %>
    <div class="flex min-w-0 items-end gap-3">
      <div class="min-w-0 flex-1">
        <%= render FlatPack::Select::Component.new(
          name: "ticket[status]",
          id: "support-ticket-status-#{ticket.id}",
          label: "Status",
          options: support_ticket_status_options,
          value: ticket.status,
          placeholder: nil,
          chrome: :cell
        ) %>
      </div>

      <div class="min-w-0 flex-1">
        <%= render FlatPack::Select::Component.new(
          name: "ticket[assignee]",
          id: "support-ticket-assignee-#{ticket.id}",
          label: "Assignee",
          options: support_ticket_assignee_options(selected: ticket.assignee),
          value: support_ticket_assignee_value(ticket.assignee),
          placeholder: nil,
          chrome: :cell
        ) %>
      </div>
    </div>
  <% end %>
<% end %>
