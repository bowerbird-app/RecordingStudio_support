<%= form_with url: url, method: method, scope: :page do %>
  <% controller = "recording-studio-support--icon-preview" %>
  <% with_section_icons = local_assigns[:section_choices].present? %>
  <div
    class="flex flex-col gap-4"
    data-controller="<%= controller %>"
    data-<%= controller %>-input-name-value="page[icon]"
    <% if with_section_icons %>
      data-<%= controller %>-section-icons-value="<%= ERB::Util.html_escape(support_section_icon_map(section_choices).to_json) %>"
      data-action="input-><%= controller %>#sync change-><%= controller %>#sectionChanged"
    <% else %>
      data-action="input-><%= controller %>#sync"
    <% end %>
  >
    <% if with_section_icons %>
      <%= render FlatPack::Select::Component.new(
        name: "page[section_id]",
        label: "Section",
        options: support_section_options(section_choices),
        value: local_assigns[:selected_section_id],
        required: true
      ) %>
    <% end %>

    <%= render FlatPack::TextInput::Component.new(
      name: "page[title]",
      label: "Title",
      value: @page.title,
      required: true,
      error: @page.errors[:title].presence&.to_sentence
    ) %>

    <%= render FlatPack::TextArea::Component.new(
      name: "page[description]",
      label: "Description",
      value: @page.description,
      rows: 2
    ) %>

    <%= render "recording_studio_support/shared/icon_field",
               scope: "page",
               value: @page.icon,
               error: @page.errors[:icon].presence&.to_sentence,
               help_text: "Paste a Heroicons name from heroicons.com — leave blank for none. Defaults to the section icon.",
               preview: false %>

    <%= render FlatPack::TextArea::Component.new(
      name: "page[body]",
      label: "Body",
      value: @page.body,
      rich_text: true,
      rich_text_options: {
        preset: :content,
        toolbar: %w[
          bold italic underline sep1
          h2 h3 sep2
          bulletList orderedList sep3
          blockquote link image sep4
          undo redo
        ],
        format: :html,
        uploads: { url: uploads_path }
      }
    ) %>

    <%= render "recording_studio_support/shared/form_actions", cancel_url: cancel_url %>
  </div>
<% end %>
