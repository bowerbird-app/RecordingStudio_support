<% back_path = @section_recording ? section_path(@section_recording) : root_path %>
<% recording_studio_page_nav(
     title: @page.title,
     page_nav_back_url: back_path,
     page_nav_anchor_url: root_path,
     page_nav_anchor_label: "Close"
   ) %>

<div class="flex w-full flex-col gap-6">
  <% live = @page_recording.respond_to?(:currently_published?) && @page_recording.currently_published? %>
  <%= render FlatPack::PageTitle::Component.new(
    title: @page.title,
    variant: :h1
  ) do |page_title| %>
    <% if can_edit_support_pages? %>
      <% page_title.slot do %>
        <% publish_href = support_publish_path(@page_recording) %>
        <% if publish_href.present? %>
          <%= render FlatPack::Button::Component.new(
            text: "Publish",
            style: :secondary,
            size: :md,
            href: publish_href
          ) %>
        <% end %>
        <%= render FlatPack::Button::Component.new(
          text: live ? "Live" : "Draft",
          style: live ? :success : :secondary,
          size: :md,
          type: "button"
        ) %>
        <%= form_with url: trash_page_path(@page_recording), method: :post, class: "inline-flex" do %>
          <%= render FlatPack::Button::Component.new(
            icon: "trash",
            icon_only: true,
            style: :ghost,
            size: :md,
            type: "submit",
            aria: { label: "Move to trash" }
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if @page.body.present? %>
    <div class="prose max-w-none text-(--surface-content-color)">
      <%= support_page_body_html(@page.body) %>
    </div>
  <% else %>
    <p class="text-sm text-(--surface-content-color)">This page is still waiting on the words.</p>
  <% end %>
</div>
