<% back_path = @section_recording ? section_path(@section_recording) : root_path %>
<% support_page_chrome(
     title: @page.title,
     back_href: back_path,
     anchor_href: RecordingStudioSupport::Admin::Queries.admin_pages_screen_path,
     anchor_tooltip: "Close"
   ) %>
<% if can_edit_support_pages? %>
  <% recording_studio_page_nav_right do %>
    <%= render RecordingStudioPublishable::QuickActions::Component.new(recording: @page_recording) %>
    <%= form_with url: trash_page_path(@page_recording), method: :post, class: "inline-flex" do %>
      <%= render FlatPack::Button::Component.new(
        icon: "trash",
        icon_only: true,
        style: :ghost,
        size: :sm,
        type: "submit",
        aria: { label: "Move to trash" }
      ) %>
    <% end %>
  <% end %>
<% end %>

<div class="flex w-full flex-col gap-6">
  <% if @page.body.present? %>
    <div class="<%= support_page_body_class %>">
      <%= support_page_body_html(@page.body) %>
    </div>
  <% else %>
    <p class="text-sm text-(--surface-content-color)">This page is still waiting on the words.</p>
  <% end %>
</div>
