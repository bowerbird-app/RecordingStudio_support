<% back_path = @section_recording ? section_path(@section_recording) : root_path %>
<% recording_studio_page_nav(
     title: @page.title,
     page_nav_back_url: back_path,
     page_nav_anchor_url: root_path,
     page_nav_anchor_label: "Close"
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @page.title,
    variant: :h1
  ) do |page_title| %>
    <% if can_edit_support_pages? %>
      <% page_title.slot do %>
        <% publish_href = support_publish_path(@page_recording) %>
        <% if publish_href.present? %>
          <%= render FlatPack::Button::Component.new(
            text: "Publish",
            style: :secondary,
            size: :md,
            href: publish_href
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% live = @page_recording.respond_to?(:currently_published?) && @page_recording.currently_published? %>
  <% if live && @page.respond_to?(:published_url) && @page.published_url.present? %>
    <%= render FlatPack::Alert::Component.new(
      description: "This page is live.",
      style: :success
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Open live page",
      style: :secondary,
      size: :md,
      href: @page.published_url
    ) %>
  <% elsif can_edit_support_pages? %>
    <%= render FlatPack::Alert::Component.new(
      description: "Not live yet. This preview is just for you.",
      style: :info
    ) %>
  <% end %>

  <% if @page.body.present? %>
    <div class="text-base leading-7 text-(--surface-content-color)">
      <%= support_page_body_html(@page.body) %>
    </div>
  <% else %>
    <p class="text-sm text-(--surface-content-color)">This page is still waiting on the words.</p>
  <% end %>

  <% if can_edit_support_pages? %>
    <%= form_with url: trash_page_path(@page_recording), method: :post do %>
      <%= render FlatPack::Button::Component.new(
        text: "Move to trash",
        style: :danger,
        size: :md,
        type: "submit"
      ) %>
    <% end %>
  <% end %>
</div>
