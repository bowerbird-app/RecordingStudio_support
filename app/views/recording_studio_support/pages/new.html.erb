<% support_page_chrome(
     title: "New page",
     subtitle: "Write it like you'd tell a teammate.",
     back_href: RecordingStudioSupport::Admin::Queries.admin_pages_screen_path,
     anchor_href: RecordingStudioSupport::Admin::Queries.admin_pages_screen_path,
     anchor_tooltip: "Close"
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render "form",
             url: pages_path,
             method: :post,
             cancel_url: RecordingStudioSupport::Admin::Queries.admin_pages_screen_path,
             section_choices: @section_choices,
             selected_section_id: @selected_section_id %>
</div>
