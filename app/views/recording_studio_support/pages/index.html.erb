<% recording_studio_page_nav(
     title: "Help",
     page_nav_anchor_url: (main_app.root_path if main_app.respond_to?(:root_path)),
     page_nav_anchor_label: "Close"
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Help",
    subtitle: "Answers you can share.",
    variant: :h1
  ) do |page_title| %>
    <% if can_edit_support_pages? %>
      <% page_title.slot do %>
        <%= render FlatPack::Button::Component.new(
          text: "New page",
          style: :primary,
          size: :md,
          href: new_page_path
        ) %>
      <% end %>
    <% end %>
  <% end %>

  <%= form_with url: pages_path, method: :get, html: { role: "search" } do %>
    <%= render FlatPack::Search::Component.new(
      name: "q",
      value: @query,
      placeholder: "Find a page",
      max_width: :none
    ) %>
  <% end %>

  <% if @page_recordings.any? %>
    <div class="flex flex-col gap-3">
      <% @page_recordings.each do |recording| %>
        <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
          <% card.body(class: "flex flex-wrap items-center justify-between gap-3") do %>
            <%= render FlatPack::SectionTitle::Component.new(
              title: recording.recordable.title,
              subtitle: nil
            ) %>
            <%= render FlatPack::Button::Component.new(
              text: "Open",
              style: :secondary,
              size: :md,
              href: page_path(recording)
            ) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% elsif @query.present? %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.body do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Nothing matches that",
          subtitle: "Try another word."
        ) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.body do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Nothing here yet",
          subtitle: "Add a page to get going."
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
