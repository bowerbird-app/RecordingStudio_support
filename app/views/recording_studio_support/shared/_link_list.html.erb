<%# square_rows: true uses Flatpack's grouped square-corner pattern (same [&>*]:rounded-none
    as ButtonGroup / SegmentedButtons) plus a flush Card body so List rows sit on the kit. %>
<%= render FlatPack::Card::Component.new do |card| %>
  <% card.body(padding: (local_assigns[:square_rows] ? :none : :md)) do %>
    <%= render FlatPack::List::Component.new(
      divider: true,
      class: ("[&>*]:rounded-none" if local_assigns[:square_rows])
    ) do %>
      <% items.each do |item| %>
        <%= render FlatPack::List::Item.new(
          href: item.fetch(:href),
          hover: true,
          trailing: support_list_chevron
        ) do %>
          <% if item[:meta] %>
            <div class="flex flex-wrap items-center gap-2">
              <span><%= item.fetch(:title) %></span>
              <%= item[:meta] %>
            </div>
          <% else %>
            <%= item.fetch(:title) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
