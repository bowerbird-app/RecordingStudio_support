<% articles = Array(local_assigns[:articles]) %>
<% query = local_assigns[:query] %>
<% section = local_assigns[:section] || @section %>
<% if articles.any? %>
  <%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg) do %>
    <% articles.each do |article| %>
      <%= render FlatPack::Card::Component.new(
        href: article.fetch(:href),
        clickable: true,
        hover: :strong,
        style: :interactive,
        theme: { background: "var(--color-white)" },
        data: { turbo_frame: "_top" }
      ) do |card| %>
        <% card.body(padding: :lg) do %>
          <h3 class="text-base font-semibold text-[var(--surface-content-color)]"><%= article.fetch(:title) %></h3>
          <% if article[:snippet].present? %>
            <p class="mt-2 text-sm text-[var(--surface-muted-content-color)]"><%= article.fetch(:snippet) %></p>
          <% end %>
          <% if article[:updated_at].present? %>
            <%= render FlatPack::Timestamp::Component.new(
              timestamp: article.fetch(:updated_at),
              class: "mt-2 text-sm text-[var(--surface-muted-content-color)]",
              fallback_text: support_page_updated_on(article.fetch(:updated_at))
            ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render "recording_studio_support/shared/public_contact_card", section: section %>
<% elsif query.present? %>
  <%= render FlatPack::EmptyState::Component.new(
    title: "Nothing matches that",
    description: "Try another word."
  ) do |empty| %>
    <% if (contact_href = support_public_contact_href).present? %>
      <% empty.slot do %>
        <%= render FlatPack::Button::Component.new(
          text: support_public_contact_label,
          style: :secondary,
          href: contact_href
        ) %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= render FlatPack::EmptyState::Component.new(
    title: "Nothing live yet",
    description: "Check back soon."
  ) %>

  <%= render "recording_studio_support/shared/public_contact_card", section: section %>
<% end %>
