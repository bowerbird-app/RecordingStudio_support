<% size = local_assigns.fetch(:size, :md) %>
<%= form_with url: url, method: :get, html: {
      role: "search",
      class: "w-full"
    } do %>
  <%= render FlatPack::Search::Component.new(
    name: "q",
    value: query,
    placeholder: local_assigns.fetch(:placeholder, support_t("help.search_placeholder")),
    max_width: :none,
    size: size,
    round: true
  ) %>
<% end %>
