<% recording_studio_page_nav(title: support_public_help_title) %>

<div class="flex w-full flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: support_public_help_title,
    variant: :h1,
    class: "text-center",
    style: "--page-title-h1-size: var(--text-5xl);"
  ) %>

  <%= render "recording_studio_support/shared/search",
        url: support_public_help_path,
        query: @query,
        size: :lg,
        prominent: true %>

  <% if @section_recordings.any? %>
    <%= render FlatPack::Grid::Component.new(cols: 3, gap: :lg) do %>
      <% @section_recordings.each do |recording| %>
        <%= render FlatPack::Card::Component.new(
          style: :interactive,
          clickable: true,
          href: support_public_section_path(recording),
          hover: :strong,
          padding: :lg,
          theme: { background: "#ffffff" }
        ) do |card| %>
          <% card.body(padding: :lg) do %>
            <div class="flex items-start gap-3">
              <% if support_section_icon_name(recording).present? %>
                <div class="mt-0.5 shrink-0"><%= support_section_icon(recording) %></div>
              <% end %>
              <div class="min-w-0 flex-1">
                <h3 class="text-base font-semibold text-[var(--surface-content-color)]"><%= support_recording_title(recording) %></h3>
                <p class="mt-1 text-sm text-[var(--surface-muted-content-color)]"><%= support_article_count_label(@page_counts.fetch(recording.id, 0)) %></p>
              </div>
            </div>
          <% end %>

        <% end %>
      <% end %>
    <% end %>
  <% elsif @query.present? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing matches that",
      description: "Try another word."
    ) do |empty| %>
      <% if (contact_href = support_public_contact_href).present? %>
        <% empty.slot do %>
          <%= render FlatPack::Button::Component.new(
            text: support_public_contact_label,
            style: :secondary,
            href: contact_href
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing live yet",
      description: "Check back soon."
    ) %>
  <% end %>
</div>
