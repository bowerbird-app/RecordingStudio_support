<% recording_studio_page_nav(title: support_public_help_title) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: support_public_help_title,
    subtitle: support_public_help_subtitle,
    variant: :h1
  ) %>

  <%= render "recording_studio_support/shared/search", url: support_public_help_path, query: @query %>

  <% if @section_recordings.any? %>
    <%= render "recording_studio_support/shared/section_expand_list", items: @section_recordings.map { |recording|
      {
        id: "public-help-section-#{recording.id}",
        title: support_recording_title(recording),
        href: support_public_section_path(recording),
        meta: support_page_count_badge(@page_counts.fetch(recording.id, 0)),
        pages: Array(@pages_by_section[recording.id]).filter_map { |page|
          href = page.published_url
          next if href.blank?

          { title: page.title, href: href }
        }
      }
    } %>
  <% elsif @query.present? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing matches that",
      description: "Try another word."
    ) %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing live yet",
      description: "Check back soon."
    ) %>
  <% end %>
</div>
