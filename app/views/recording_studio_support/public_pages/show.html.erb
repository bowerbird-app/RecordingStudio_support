<% back_path = @section_recording ? support_public_section_path(@section_recording) : support_public_help_path %>
<% recording_studio_page_nav(
     title: @page.title,
     page_nav_back_url: back_path
   ) %>
<% content_for :page_nav_secondary_anchor_url, support_public_help_path %>
<% content_for :page_nav_secondary_anchor_icon, "home" %>
<% content_for :page_nav_secondary_anchor_tooltip, "Home" %>
<% recording_studio_seo_description(
     support_page_meta_description(@page.body, description: @page.description)
   ) %>

<div class="flex w-full flex-col">
  <div class="flex flex-col items-center gap-1.5 text-center">
    <% section_title = support_recording_title(@section_recording) %>
    <% if section_title.present? %>
      <div class="w-fit">
        <%= render FlatPack::Badge::Component.new(
          text: section_title,
          style: :default,
          size: :lg
        ) %>
      </div>
    <% end %>

    <%# -mb-6 cancels PageTitle's stock mb-6 so gap-1.5 owns header rhythm %>
    <div class="-mb-6 w-full" style="--page-title-h1-size: var(--text-5xl);">
      <%= render FlatPack::PageTitle::Component.new(
        title: @page.title,
        subtitle: support_page_updated_on(@updated_at),
        variant: :h1,
        class: "text-center"
      ) %>
    </div>
  </div>

  <%= publishable_preview_badge %>

  <% if @page.body.present? %>
    <%= render FlatPack::Content::Component.new(class: "mt-8 mb-8 pb-8") do |content| %>
      <%= support_page_body_html(@page.body) %>
    <% end %>
  <% end %>

  <% if (contact_href = support_public_contact_href).present? %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.body do %>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <% if (section = @section_recording&.recordable).present? %>
            <p class="text-[var(--surface-content-color)]"><%= support_public_contact_prompt(section) %></p>
          <% end %>
          <%= render FlatPack::Button::Component.new(
            text: support_public_contact_label,
            style: :secondary,
            href: contact_href
          ) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
