<% back_path = @section_recording ? support_public_section_path(@section_recording) : support_public_help_path %>
<% support_page_chrome(
     title: @page.title,
     subtitle: support_page_updated_on(@updated_at),
     back_href: back_path,
     anchor_href: support_public_help_path,
     anchor_icon: "home",
     anchor_tooltip: support_t("help.home")
   ) %>
<% recording_studio_seo_description(
     support_page_meta_description(@page.body, description: @page.description)
   ) %>

<div class="flex w-full flex-col">
  <div class="flex flex-col items-center gap-1.5 text-center">
    <% section_title = support_recording_title(@section_recording) %>
    <% if section_title.present? %>
      <div class="w-fit">
        <%= render FlatPack::Badge::Component.new(
          text: section_title,
          style: :default,
          size: :lg
        ) %>
      </div>
    <% end %>
  </div>

  <%= publishable_preview_badge %>

  <% if @page.body.present? %>
    <%= render FlatPack::Content::Component.new(class: "mt-8 mb-8 pb-8") do |content| %>
      <%= support_page_body_html(@page.body) %>
    <% end %>
  <% end %>

  <%= render "recording_studio_support/shared/public_contact_card",
        section: @section_recording&.recordable %>
</div>
