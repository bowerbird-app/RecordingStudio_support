<% back_path = @section_recording ? support_public_section_path(@section_recording) : support_public_help_path %>
<% recording_studio_page_nav(
     title: @page.title,
     page_nav_back_url: back_path,
     page_nav_anchor_url: support_public_help_path,
     page_nav_anchor_label: "Close"
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @page.title,
    subtitle: support_page_updated_on(@published_at),
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <% if @page.body.present? %>
        <div class="text-base leading-7 text-(--surface-content-color)">
          <%= support_page_body_html(@page.body) %>
        </div>
      <% else %>
        <p class="text-sm text-(--surface-content-color)">This page is still waiting on the words.</p>
      <% end %>
    <% end %>
  <% end %>

  <% if @images.any? %>
    <div class="flex flex-col gap-3">
      <%= render FlatPack::SectionTitle::Component.new(title: "Pictures") %>
      <% @images.each do |image_recording| %>
        <% image_url = support_page_image_url(image_recording) %>
        <% next if image_url.blank? %>
        <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
          <% card.body do %>
            <%= image_tag image_url, alt: support_page_image_name(image_recording), class: "max-h-96 w-auto max-w-full" %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
