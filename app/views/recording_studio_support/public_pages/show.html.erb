<% back_path = @section_recording ? support_public_section_path(@section_recording) : support_public_help_path %>
<% recording_studio_page_nav(
     title: @page.title,
     page_nav_back_url: back_path,
     page_nav_anchor_url: support_public_help_path,
     page_nav_anchor_label: "Close"
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @page.title,
    subtitle: support_page_updated_on(@published_at),
    variant: :h1
  ) %>

  <% if @page.body.present? %>
    <div class="prose max-w-none text-(--surface-content-color)">
      <%= support_page_body_html(@page.body) %>
    </div>
  <% end %>

  <% if @related_pages.any? %>
    <hr class="w-full border-0 border-t border-[var(--surface-border-color)]">

    <%= render FlatPack::SectionTitle::Component.new(title: "Related") %>

    <%= render "recording_studio_support/shared/link_list", items: @related_pages.filter_map { |page|
      href = page.published_url
      next if href.blank?

      { title: page.title, href: href }
    } %>
  <% end %>
</div>
