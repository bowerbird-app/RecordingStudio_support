<% support_public_section_page_nav(title: @section.title) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @section.title,
    subtitle: @section_subtitle,
    variant: :h1
  ) %>

  <%= render "recording_studio_support/shared/page_search",
        url: support_public_section_path(@section_recording),
        instant_url: support_public_section_instant_search_path(@section_recording),
        query: @query,
        placeholder: support_public_section_search_placeholder(@section),
        size: :lg %>

  <%= tag.turbo_frame id: RecordingStudioSupport::InstantPages::FRAME_ID do %>
    <%= render "recording_studio_support/shared/article_cards", articles: @articles, query: @query %>
  <% end %>

  <% if (contact_href = support_public_contact_href).present? %>
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.body do %>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-[var(--surface-content-color)]"><%= support_public_contact_prompt(@section) %></p>
          <%= render FlatPack::Button::Component.new(
            text: support_public_contact_label,
            style: :secondary,
            href: contact_href
          ) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
