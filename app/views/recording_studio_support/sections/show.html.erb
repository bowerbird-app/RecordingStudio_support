<% support_page_chrome(
     title: @section.title,
     back_href: RecordingStudioSupport::Admin::Queries.admin_sections_screen_path,
     anchor_href: RecordingStudioSupport::Admin::Queries.admin_sections_screen_path,
     anchor_tooltip: "Close"
   ) %>
<% if can_edit_support_pages? %>
  <% register_page_nav "New page", new_page_path(section_id: @section_recording.id), role: :primary %>
<% end %>

<div class="flex w-full flex-col gap-6">
  <%= render "recording_studio_support/shared/page_search",
        url: section_path(@section_recording),
        instant_url: instant_search_section_path(@section_recording),
        query: @query %>

  <%= tag.turbo_frame id: RecordingStudioSupport::InstantPages::FRAME_ID do %>
    <%= render "recording_studio_support/shared/section_pages",
          page_recordings: @page_recordings,
          query: @query %>
  <% end %>
</div>
