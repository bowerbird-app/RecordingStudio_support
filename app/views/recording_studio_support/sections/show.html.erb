<% recording_studio_page_nav(
     title: @section.title,
     page_nav_back_url: root_path,
     page_nav_anchor_url: root_path,
     page_nav_anchor_label: "Close"
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @section.title,
    variant: :h1
  ) %>

  <%= form_with url: section_path(@section_recording), method: :get, html: { role: "search", class: "w-full" } do %>
    <%= render FlatPack::Search::Component.new(
      name: "q",
      value: @query,
      placeholder: "Find a page",
      max_width: :none,
      class: "w-full"
    ) %>
  <% end %>

  <% if @page_recordings.any? %>
    <%= render "recording_studio_support/shared/link_list", items: @page_recordings.map { |recording|
      {
        title: support_recording_title(recording),
        href: page_path(recording),
        meta: support_page_status_badge(recording)
      }
    } %>
  <% elsif @query.present? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing matches that",
      description: "Try another word."
    ) %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing here yet",
      description: "Add a page to get going."
    ) %>
  <% end %>
</div>
