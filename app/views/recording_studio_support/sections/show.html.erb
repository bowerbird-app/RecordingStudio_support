<% recording_studio_page_nav(
     title: @section.title,
     page_nav_back_url: root_path,
     page_nav_anchor_url: root_path,
     page_nav_anchor_label: "Close"
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @section.title,
    variant: :h1
  ) %>

  <%= form_with url: section_path(@section_recording), method: :get, html: { role: "search", class: "w-full" } do %>
    <%= render FlatPack::Search::Component.new(
      name: "q",
      value: @query,
      placeholder: "Find a page",
      max_width: :none,
      class: "w-full"
    ) %>
  <% end %>

  <% if @page_recordings.any? %>
    <div class="flex flex-col gap-3">
      <% @page_recordings.each do |recording| %>
        <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
          <% card.body(class: "flex flex-wrap items-center justify-between gap-3") do %>
            <div class="flex flex-wrap items-center gap-2">
              <%= render FlatPack::SectionTitle::Component.new(
                title: support_recording_title(recording),
                subtitle: nil
              ) %>
              <% if recording.respond_to?(:current_publishable) && recording.current_publishable %>
                <%= render RecordingStudioPublishable::StatusBadge::Component.new(
                  publishable: recording.current_publishable
                ) %>
              <% else %>
                <%= render FlatPack::Badge::Component.new(text: "Draft", style: :info, size: :sm) %>
              <% end %>
            </div>
            <%= render FlatPack::Button::Component.new(
              text: "Open",
              style: :secondary,
              size: :md,
              href: page_path(recording)
            ) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% elsif @query.present? %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.body do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Nothing matches that",
          subtitle: "Try another word."
        ) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.body do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Nothing here yet",
          subtitle: "Add a page to get going."
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
