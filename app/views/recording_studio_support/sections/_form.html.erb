<%= form_with url: url, method: method, scope: :section do %>
  <div class="flex flex-col gap-4">
    <%= render FlatPack::TextInput::Component.new(
      name: "section[title]",
      label: "Name",
      value: @section.title,
      required: true,
      error: @section.errors[:title].presence&.to_sentence
    ) %>

    <%= render "recording_studio_support/shared/form_actions", cancel_url: cancel_url %>
  </div>
<% end %>
