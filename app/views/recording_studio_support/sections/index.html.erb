<% recording_studio_page_nav(
     title: support_help_title,
     page_nav_anchor_url: (main_app.root_path if main_app.respond_to?(:root_path)),
     page_nav_anchor_label: "Close"
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: support_help_title,
    subtitle: support_help_subtitle,
    variant: :h1
  ) %>

  <%= form_with url: root_path, method: :get, html: { role: "search", class: "w-full" } do %>
    <%= render FlatPack::Search::Component.new(
      name: "q",
      value: @query,
      placeholder: "Find a section",
      max_width: :none,
      class: "w-full"
    ) %>
  <% end %>

  <% if @section_recordings.any? %>
    <%= render "recording_studio_support/shared/link_list", items: @section_recordings.map { |recording|
      {
        title: support_recording_title(recording),
        href: section_path(recording)
      }
    } %>
  <% elsif @query.present? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing matches that",
      description: "Try another word."
    ) %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing here yet",
      description: "Add a section to get going."
    ) %>
  <% end %>
</div>
