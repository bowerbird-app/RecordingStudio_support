<% support_page_chrome(
     title: support_help_title,
     subtitle: support_help_subtitle,
     anchor_href: (main_app.root_path if main_app.respond_to?(:root_path)),
     anchor_tooltip: "Close"
   ) %>
<% if can_edit_support_pages? %>
  <% register_page_nav "New section", new_section_path, role: :secondary %>
  <% register_page_nav "New page", new_page_path, role: :primary %>
<% end %>

<div class="flex w-full flex-col gap-6">
  <%= render "recording_studio_support/shared/search", url: root_path, query: @query %>

  <% if @section_recordings.any? %>
    <%= render "recording_studio_support/shared/link_list", items: @section_recordings.map { |recording|
      {
        title: support_recording_title(recording),
        href: section_path(recording),
        meta: support_page_count_badge(@page_counts.fetch(recording.id, 0))
      }
    } %>
  <% elsif @query.present? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing matches that",
      description: "Try another word."
    ) %>
  <% elsif can_edit_support_pages? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing here yet",
      description: "Add a section to get going."
    ) %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Nothing live yet",
      description: "Check back soon."
    ) %>
  <% end %>
</div>
