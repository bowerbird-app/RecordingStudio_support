<% recording_studio_page_nav(
     title: support_help_title,
     page_nav_anchor_url: (main_app.root_path if main_app.respond_to?(:root_path)),
     page_nav_anchor_label: "Close"
   ) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: support_help_title,
    subtitle: support_help_subtitle,
    variant: :h1
  ) %>

  <%= form_with url: root_path, method: :get, html: { role: "search", class: "w-full" } do %>
    <%= render FlatPack::Search::Component.new(
      name: "q",
      value: @query,
      placeholder: "Find a section",
      max_width: :none,
      class: "w-full"
    ) %>
  <% end %>

  <% if @section_recordings.any? %>
    <div class="flex flex-col gap-3">
      <% @section_recordings.each do |recording| %>
        <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
          <% card.body(class: "flex flex-wrap items-center justify-between gap-3") do %>
            <%= render FlatPack::SectionTitle::Component.new(
              title: recording.recordable.title,
              subtitle: nil
            ) %>
            <%= render FlatPack::Button::Component.new(
              text: "Open",
              style: :secondary,
              size: :md,
              href: section_path(recording)
            ) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% elsif @query.present? %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.body do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Nothing matches that",
          subtitle: "Try another word."
        ) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.body do %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: "Nothing here yet",
          subtitle: "Add a section to get going."
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
