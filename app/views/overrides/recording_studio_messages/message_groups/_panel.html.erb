<% current_actor = local_assigns.fetch(:current_actor) %>
<% group_recording = local_assigns.fetch(:group_recording) %>
<% message_recordings = local_assigns.fetch(:message_recordings) %>
<% form_url = local_assigns[:form_url].presence || messages_panel_form_url(group_recording) %>
<% return_to = local_assigns[:return_to].presence || messages_panel_return_to %>
<% membership_open = !RecordingStudioMessages.membership_locked_for_group?(group_recording) %>
<% hook_mount = group_recording.parent_recording %>
<% right_header = messages_panel_right_header(group_recording, actor: current_actor, mount: hook_mount) %>
<% right_header_mobile = messages_panel_right_header_mobile(group_recording, actor: current_actor, mount: hook_mount) %>
<% panel_after = messages_panel_after(group_recording, actor: current_actor, mount: hook_mount) %>
<% ticket_bar = support_ticket_thread_bar(group_recording, actor: current_actor, mount: hook_mount) if respond_to?(:support_ticket_thread_bar) %>

<%= render FlatPack::Chat::Panel::Component.new(class: "flat-pack--chat-panel") do |panel| %>
  <% panel.header do %>
    <%= render FlatPack::Chat::Header::Component.new(
      title: group_recording.recordable.title
    ) do |header| %>
      <% if membership_open %>
        <% header.right do %>
          <%= recording_studio_accessible_avatars(group_recording, button_style: :ghost) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if right_header.present? %>
    <% panel.right_header do %>
      <div class="flex items-center gap-2 whitespace-nowrap p-4">
        <%= right_header %>
      </div>
    <% end %>
  <% end %>

  <% if right_header_mobile.present? %>
    <% panel.right_header_mobile do %>
      <div class="flex items-center gap-2 whitespace-nowrap p-4">
        <%= right_header_mobile %>
      </div>
    <% end %>
  <% end %>

  <% panel.messages do %>
    <%= ticket_bar %>
    <%= render "recording_studio_messages/message_groups/message_list",
               group_recording: group_recording,
               message_recordings: message_recordings,
               current_actor: current_actor %>
  <% end %>

  <% panel.composer do %>
    <%= render "recording_studio_messages/message_groups/composer",
               group_recording: group_recording,
               form_url: form_url,
               return_to: return_to %>
  <% end %>
<% end %><% if panel_after.present? %><%= panel_after %><% end %>
